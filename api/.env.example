NODE_ENV=development
PORT=8000

# MySQL connection string, e.g. mysql://user:password@localhost:3306/duoconvo
DATABASE_URL=mysql://root:password@localhost:3306/duoconvo

# Comma-separated list of allowed origins, or "*" for any origin
CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

UPLOAD_MAX_FILE_SIZE_MB=10

# AI retrieval engine (fine-tuned Sentence Transformer + FAISS + confidence engine).
# "mock" uses src/data/mockKnowledgeBase.ts so the API works end-to-end before the
# real model is wrapped in an HTTP service. Switch to "http" once it's ready.
AI_PROVIDER=mock
AI_ENGINE_URL=http://localhost:8001
AI_ENGINE_TIMEOUT_MS=5000

# Mirrors ai-engine/inference/confidence.py's experimental thresholds.
CONFIDENCE_HIGH_THRESHOLD=0.60
CONFIDENCE_MEDIUM_THRESHOLD=0.35

# Speech-to-text engine, used by POST /translate/audio.
STT_PROVIDER=mock
STT_ENGINE_URL=http://localhost:8002

# Text-to-speech engine, used to generate TranslationResult.audioUrl.
TTS_PROVIDER=mock
TTS_ENGINE_URL=http://localhost:8003

# External LLM fallback, invoked only when AI confidence is LOW_CONFIDENCE
# or a matched concept has no verified translation yet.
LLM_FALLBACK_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
